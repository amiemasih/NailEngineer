# Local dev uses SQLite (datasource provider is "sqlite" in schema.prisma).
DATABASE_URL="file:./dev.db"
# Production: set the datasource provider to "postgresql" and use the Supabase
# Postgres connection strings (Supabase → Project → Database → Connection string).
#   DATABASE_URL = pooled URI, port 6543, add ?pgbouncer=true   (runtime)
#   DIRECT_URL   = direct URI, port 5432                         (migrations)
# DATABASE_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres"
AUTH_SECRET="generate-a-long-random-string-for-production"

# Jayden’s scheduling dashboard (/tech/login), min 16 chars
TECH_DASHBOARD_SECRET="generate-a-different-long-secret-for-tech-jwt"
# Plain password for technician login (set in production)
TECH_DASHBOARD_PASSWORD="change-me"

# Google Calendar two-way sync for bookings (see src/lib/google-calendar.ts).
# Optional: without these, bookings still work and Google sync stays off.
# 1. Google Cloud Console: create a project, enable the Google Calendar API.
# 2. APIs & Services > Credentials > Create OAuth client ID > Web application.
# 3. Add the redirect URI below to the client's "Authorized redirect URIs".
# 4. Copy the client ID/secret here, then click "Connect Google Calendar" on
#    the tech dashboard to grant access.
# GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-client-secret"
# Local dev redirect URI; in prod use https://nailengineer.org/api/google/oauth/callback
# GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/google/oauth/callback"

# Supabase Storage, AI training-image uploads (/tech/training-data)
# Project URL + service-role key from Supabase → Project Settings → API.
# The service-role key is SECRET and server-only, never expose to the browser.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Optional: bucket name (auto-created on first upload). Default: nail-training-data
# SUPABASE_TRAINING_BUCKET="nail-training-data"

# Email notification on each training-image submission (Resend).
# Get a key at resend.com → API Keys. Without it, submissions still work but
# no email is sent. Sending is best-effort and never blocks an upload.
# RESEND_API_KEY="re_your_key"
# Optional: comma-separated recipients
# (default: thenailengineermail@gmail.com,peanjayden@gmail.com)
# TRAINING_NOTIFY_EMAIL="thenailengineermail@gmail.com,peanjayden@gmail.com"
# Optional: verified sender. The default onboarding@resend.dev only delivers to
# the Resend account owner; use an address on your verified domain in prod.
# TRAINING_NOTIFY_FROM="Nail Engineer <notify@nailengineer.org>"
