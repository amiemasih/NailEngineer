DATABASE_URL="file:./dev.db"
AUTH_SECRET="generate-a-long-random-string-for-production"

# Jayden’s scheduling dashboard (/tech/login) — min 16 chars
TECH_DASHBOARD_SECRET="generate-a-different-long-secret-for-tech-jwt"
# Plain password for technician login (set in production)
TECH_DASHBOARD_PASSWORD="change-me"

# Optional: Google Calendar push for bookings (see src/lib/google-calendar.ts)
# GOOGLE_CALENDAR_SYNC_ENABLED="true"

# Supabase Storage — AI training-image uploads (/tech/training-data)
# Project URL + service-role key from Supabase → Project Settings → API.
# The service-role key is SECRET and server-only — never expose to the browser.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Optional: bucket name (auto-created on first upload). Default: nail-training-data
# SUPABASE_TRAINING_BUCKET="nail-training-data"
