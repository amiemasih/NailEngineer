generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  enrollments     Enrollment[]
  lessonProgress  LessonProgress[]
}

model Course {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  subtitle     String?
  description  String
  level        String
  durationMins Int
  order        Int      @default(0)

  modules     CourseModule[]
  enrollments Enrollment[]
}

model CourseModule {
  id          String @id @default(cuid())
  courseId    String
  title       String
  summary     String
  order       Int    @default(0)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
}

model Lesson {
  id           String @id @default(cuid())
  moduleId     String
  title        String
  contentMd    String
  videoUrl     String?
  durationMins Int    @default(10)
  order        Int    @default(0)

  module   CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@index([moduleId])
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

enum AvailabilityState {
  FREE
  LIMITED
  UNAVAILABLE
}

/// Jayden-defined windows (include travel/buffer by ending availability earlier than hard commitments).
model AvailabilityBlock {
  id        String            @id @default(cuid())
  startAt   DateTime
  endAt     DateTime
  state     AvailabilityState
  note      String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([startAt, endAt])
}

model Booking {
  id          String   @id @default(cuid())
  startAt     DateTime
  endAt       DateTime
  serviceId   String
  serviceName String
  clientName  String
  clientEmail String
  clientPhone String?
  status      String   @default("confirmed")
  notes       String?
  /// Google Calendar event id, when this booking was pushed to Jayden's calendar.
  googleEventId String?
  createdAt   DateTime @default(now())

  @@index([startAt, endAt])
  @@index([status])
}

/// Stored Google Calendar OAuth credentials for Jayden's account. Single row
/// (id is fixed) — the app pushes bookings to and reads busy time from this
/// account. Refresh token persists; access token is cached until it expires.
model GoogleCalendarAccount {
  id           String    @id @default("default")
  email        String?
  calendarId   String    @default("primary")
  refreshToken String
  accessToken  String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// One submission of training photos for a single step, attributed to the
/// nail school or individual tech/salon who sent them.
model TrainingSubmission {
  id            String   @id @default(cuid())
  submitterName String
  submitterType String   // "school" | "individual"
  stepId        String
  stepTitle     String
  createdAt     DateTime @default(now())

  images TrainingImageFile[]

  @@index([createdAt])
}

model TrainingImageFile {
  id           String @id @default(cuid())
  submissionId String
  path         String @unique // Supabase Storage path
  name         String

  submission TrainingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

/// A report that nails popped off, with which fingers and when. `leftFingers`
/// and `rightFingers` hold a JSON-encoded string array (e.g. ["thumb","index"])
/// so the schema stays portable between SQLite (local) and Postgres (prod).
model PopOffReport {
  id            String    @id @default(cuid())
  submitterName String
  submitterType String
  leftFingers   String    @default("[]")
  rightFingers  String    @default("[]")
  nailsDoneDate DateTime?
  poppedOffDate DateTime?
  notes         String?
  createdAt     DateTime  @default(now())

  images PopOffImageFile[]

  @@index([createdAt])
}

model PopOffImageFile {
  id       String @id @default(cuid())
  reportId String
  path     String @unique
  name     String

  report PopOffReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}
